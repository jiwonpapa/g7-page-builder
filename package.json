{
  "name": "@jiwonpapa/g7-page-builder",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "NODE_ENV=production vite build && NODE_ENV=production vite build --config vite.effects.config.ts",
    "check:version": "node scripts/check-version-policy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e:infra": "playwright test tests/E2E/infrastructure.spec.ts",
    "test:e2e:product": "playwright test tests/E2E/pageBuilderLifecycle.spec.ts tests/E2E/sitePartLifecycle.spec.ts",
    "check:g7-budget": "node scripts/check-g7-dependency-budget.mjs",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm run check:version && npm run typecheck && npm run test:coverage && npm run check:g7-budget && npm run check:boundaries && npm run build && npm run check:assets"
  },
  "dependencies": {
    "@puckeditor/core": "0.23.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "lucide-react": "1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
