          "allOf": [{
            "if": { "properties": { "src": { "type": "string", "minLength": 1 } }, "required": ["src"] },
            "then": { "properties": { "alt": { "type": "string", "minLength": 1 } } }
          }]
        },
        "mediaPosition": { "enum": ["left", "right"] },
        "primaryLink": { "$ref": "#/$defs/link" },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "iconListProps": {
      "type": "object",
