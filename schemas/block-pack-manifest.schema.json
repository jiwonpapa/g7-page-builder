{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jiwonpapa.dev/g7-page-builder/block-pack-manifest-v1.json",
  "title": "G7 Page Builder Block Pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "pack_id",
    "pack_version",
    "kind",
    "publisher",
    "compatibility",
    "blocks",
    "presets",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "const": "g7pb-block-pack/v1"
    },
    "pack_id": {
      "$ref": "#/$defs/packId"
    },
    "pack_version": {
      "$ref": "#/$defs/semver"
    },
    "kind": {
      "enum": ["data", "code"]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_builder", "php", "g7"],
      "properties": {
        "page_builder": { "$ref": "#/$defs/versionConstraint" },
        "php": { "$ref": "#/$defs/versionConstraint" },
        "g7": { "$ref": "#/$defs/versionConstraint" }
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/blockDefinition"
      }
    },
    "presets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/blockPreset"
      }
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/safeRelativePath"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "maxProperties": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "data" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "blocks": { "type": "array", "maxItems": 0 },
          "runtime": false
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "code" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["runtime"],
        "properties": {
          "blocks": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}/[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "versionConstraint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko"],
      "properties": {
        "ko": { "type": "string", "minLength": 1, "maxLength": 240 },
        "en": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$"
      }
    },
    "blockDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "block_version",
        "category",
        "label",
        "description",
        "thumbnail",
        "schema_ref",
        "editor_component",
        "compiler",
        "capabilities"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$"
        },
        "block_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "label": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "thumbnail": { "$ref": "#/$defs/safeRelativePath" },
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "editor_component": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{1,127}$"
        },
        "compiler": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$"
        },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "blockPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_id",
        "block_id",
        "block_version",
        "category",
        "label",
        "description",
        "thumbnail",
        "props"
      ],
      "properties": {
        "preset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$"
        },
        "block_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$"
        },
        "block_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "label": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "thumbnail": { "$ref": "#/$defs/safeRelativePath" },
        "props": {
          "type": "object"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "editor", "styles"],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$"
        },
        "editor": { "$ref": "#/$defs/safeRelativePath" },
        "styles": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/safeRelativePath" }
        }
      }
    }
  }
}
