    "contactProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "address", "phone", "email"],
      "properties": {
        "heading": {
          "$ref": "#/$defs/inlineRichTextString",
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "phone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^\\+?[0-9][0-9 .()\\-]{2,39}$"
