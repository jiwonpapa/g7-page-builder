        "plans": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["name", "price", "period", "description", "features", "buttonLabel", "buttonUrl", "featured"], "properties": { "name": { "$ref": "#/$defs/inlineRichTextString", "type": "string", "minLength": 1 }, "price": { "type": "string", "minLength": 1, "maxLength": 80 }, "period": { "type": "string", "maxLength": 40 }, "description": { "$ref": "#/$defs/blockRichTextString" }, "features": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/inlineRichTextString", "type": "string", "minLength": 1 } }, "buttonLabel": { "type": "string", "minLength": 1, "maxLength": 120 }, "buttonUrl": { "type": "string", "minLength": 1, "maxLength": 2048 }, "featured": { "type": "boolean" } } } },
        "layout": { "enum": ["cards", "featured", "compact", "editorial"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "teamProps": {
      "type": "object", "additionalProperties": false, "required": ["eyebrow", "heading", "members"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 }, "heading": { "$ref": "#/$defs/inlineRichTextString", "type": "string", "minLength": 1 },
