    "ctaProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "body", "theme"],
      "properties": {
        "eyebrow": {
          "type": "string",
          "maxLength": 120
        },
        "heading": {
          "$ref": "#/$defs/inlineRichTextString",
          "type": "string",
          "minLength": 1
        },
        "body": {
          "$ref": "#/$defs/blockRichTextString"
        },
        "primaryLink": {
          "$ref": "#/$defs/link"
        },
        "secondaryLink": {
          "$ref": "#/$defs/link"
        },
        "theme": {
          "enum": ["light", "dark"]
        },
        "layout": {
          "enum": ["split", "centered", "banner", "panel"]
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        }
      }
