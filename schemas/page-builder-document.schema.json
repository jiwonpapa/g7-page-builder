        "eyebrow": { "type": "string", "maxLength": 120 },
        "title": { "$ref": "#/$defs/inlineRichTextString", "type": "string", "minLength": 1 },
        "body": { "$ref": "#/$defs/blockRichTextString" },
        "primaryCta": { "$ref": "#/$defs/link" },
        "image": { "$ref": "#/$defs/image" },
