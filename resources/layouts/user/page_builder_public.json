{
  "version": "1.0.0",
  "layout_name": "page_builder_public",
  "extends": "_user_base",
  "meta": {
    "title": "{{page?.data?.page?.title ?? ''}}",
    "seo": {
      "enabled": true,
      "data_sources": ["page"],
      "priority": 0.6,
      "changefreq": "monthly",
      "og": {
        "type": "website",
        "title": "{{page?.data?.page?.title ?? ''}}"
      },
      "structured_data": {
        "@type": "WebPage",
        "name": "{{page?.data?.page?.title ?? ''}}",
        "datePublished": "{{page?.data?.page?.published_at ?? ''}}"
      }
    }
  },
  "data_sources": [
    {
      "id": "page",
      "type": "api",
      "endpoint": "/api/modules/jiwonpapa-page_builder/public/pages/{{route?.slug}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "loading_strategy": "blocking",
      "fallback": {
        "data": null
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page_builder_public_content",
        "type": "composite",
        "name": "HtmlContent",
        "if": "{{page?.data?.page?.artifact}}",
        "props": {
          "content": "{{page?.data?.page?.artifact ?? ''}}",
          "isHtml": true,
          "className": "g7pb-page g7pb-template-page"
        }
      }
    ]
  }
}
