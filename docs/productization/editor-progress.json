  "acceptance": [
    {
      "id": "NAT-01",
      "description": "지원 템플릿의 실제 일반 페이지에서 한 노드 편집→Undo/Redo→저장→재열기. 수정 외 의미 diff 0, 출처·표현식·번역·반복·actions·responsive·알 수 없는 필드 보존. readonly·라우트 전환·늦은 응답은 무변경.",
      "required_evidence": [
        "host-contract",
        "unit",
        "browser"
      ]
    },
    {
      "id": "NAT-02",
      "description": "지원된 문구·링크·이미지·alt·비율·스타일을 같은 노드 명령으로 편집하고 Undo·저장·재열기 결과를 비교. 바인딩 보존, 업로드 취소·실패·늦은 응답·문서 전환에서 오적용 0.",
      "required_evidence": [
        "unit",
        "browser"
      ]
    },
    {
      "id": "NAT-03",
      "description": "children·prop 내부 트리·배열·반복 템플릿의 삽입/이동/복제/삭제 및 거부 경로를 확인. ID·참조·출처 보존, 한 명령 Undo/Redo, Slider 항목 편집과 공개 동작 검증.",
      "required_evidence": [
        "unit",
        "browser",
        "runtime"
      ]
    },
    {
      "id": "NAT-04",
      "description": "선택 조합 저장→목록→다른 허용 위치 삽입→Undo→저장→재열기. 포맷·버전·자산·컴포넌트 호환 거부와 새 ID/내부 참조 재연결을 검증.",
      "required_evidence": [
        "unit",
        "browser"
      ]
    },
    {
      "id": "NAT-05",
      "description": "찾기→위치 선택→삽입→상세 편집→기존 페이지 설정→미리보기→저장→재열기 흐름을 실제 일반 페이지에서 확인. 공개 영향·문서 제목·라우트·오류·취소가 구분됨.",
      "required_evidence": [
        "unit",
        "browser"
      ]
    },
    {
      "id": "NAT-06",
      "description": "검증한 G7/지원 템플릿 조합과 기존 PB 문서·발행본·주소가 공존. 실제 동시 저장·권한·장애 복구·반응형 공개 출력 통과 후 승인 범위의 릴리스와 운영 재열기/공개 결과 증거 기록.",
      "required_evidence": [
        "compatibility",
        "browser",
        "concurrency",
        "deployment"
      ]
    },
    {
      "id": "UI-01",
      "description": "짧은 공통 옵션 직접 선택, PAGE 선택 UI 밀도, 공통 배치 라벨, 기기별 접기/변경 요약 및 자산 내용 해시 URL. 대표 편집·Undo·저장·재열기 검증.",
      "required_evidence": [
        "unit",
        "browser"
      ]
    },
    {
      "id": "UI-02",
      "description": "Hero 기기별 정렬·글자 비율의 캔버스/미리보기/발행 일치, 슬라이더 요약의 서식 제거와 원본 보존.",
      "required_evidence": [
        "unit",
        "browser"
      ]
    },
    {
      "id": "UI-03",
      "description": "Hero extra 배지·목록 각 1개의 내부 삽입·편집·순서·삭제·저장/재열기·컴파일/발행 보존. 다른 내부 슬롯은 제외.",
      "required_evidence": [
        "unit",
        "browser"
      ]
    },
    {
      "id": "UI-04",
      "description": "ImageText extra 배지·목록·구분선 각 1개 내부 편집 및 빠른 연속 Undo/Redo 원본/출력 보존.",
      "required_evidence": [
