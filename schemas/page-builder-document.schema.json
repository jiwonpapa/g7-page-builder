{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jiwonpapa.dev/g7-page-builder/document-v1.json",
  "title": "G7 Page Builder Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "slug", "mode", "locale", "blocks"],
  "properties": {
    "schema_version": {
      "const": "g7-page-builder/v1"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "const": "canvas"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "shell_mode": {
      "enum": ["template", "builder", "none", "global"],
      "default": "template"
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "og_image_url", "robots"],
      "properties": {
        "title": { "type": "string", "maxLength": 70 },
        "description": { "type": "string", "maxLength": 200 },
        "og_image_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|/[^\\s]*|https://[^\\s]+)$"
        },
        "robots": { "enum": ["index", "noindex"] }
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "design.palette": { "enum": ["indigo", "blue", "emerald", "amber", "rose", "slate"] },
        "design.font": { "enum": ["system", "modern", "serif"] },
        "design.radius": { "enum": ["sharp", "soft", "round"] },
        "design.width": { "enum": ["narrow", "standard", "wide"] },
        "design.scale": { "enum": ["compact", "balanced", "large"] }
      },
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      },
      "default": {}
    },
    "blocks": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "inlineRichTextString": {
      "type": "string",
      "maxLength": 10000
    },
    "blockRichTextString": {
      "type": "string",
      "maxLength": 100000
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "type", "block_version", "props"],
      "properties": {
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]+$"
        },
        "block_version": {
          "type": "integer",
          "minimum": 1
        },
        "props": {
          "type": "object"
        },
        "motion": {
          "$ref": "#/$defs/motion"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/$defs/block"
            }
          },
          "default": {}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "content.cta-split-01" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "block_version": { "const": 1 },
              "props": { "$ref": "#/$defs/ctaProps" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "content.contact-info-01" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "block_version": { "const": 1 },
              "props": { "$ref": "#/$defs/contactProps" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "content.hero-split-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/heroSplitProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.hero-slider-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/heroSliderProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "trust.logo-cloud-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/logoCloudProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "data.stats-icons-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/statsProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "commerce.pricing-tiers-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/pricingProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "company.team-grid-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/teamProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "media.gallery-grid-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/galleryProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "data.bar-chart-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/barChartProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "g7.board-recent-posts-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/g7RecentPostsProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "g7.ecommerce-product-grid-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/g7ProductGridProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "g7.board-post-detail-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/g7PostDetailProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "g7.ecommerce-product-detail-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/g7ProductDetailProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.heading-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/headingProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.rich-text-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/richTextProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "media.image-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/imageBlockProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "action.buttons-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/buttonsProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "media.image-text-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/imageTextProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.icon-list-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/iconListProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.divider-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/dividerProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.blockquote-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/blockquoteProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.notice-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/noticeProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.card-grid-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/cardGridProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "navigation.breadcrumbs-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/breadcrumbsProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "navigation.anchor-menu-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/anchorMenuProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "navigation.social-links-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/socialLinksProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "media.image-carousel-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/imageCarouselProps" } } }
        },
        {
          "$ref": "#/$defs/richTextEnvelopeOverlay"
        }
      ]
    },
    "richTextEnvelopeOverlay": {
      "type": "object",
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "content.hero-centered-01" } }, "required": ["type"] },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "title": { "$ref": "#/$defs/inlineRichTextString" },
                  "body": { "$ref": "#/$defs/blockRichTextString" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "content.features-grid-01" } }, "required": ["type"] },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "title": { "$ref": "#/$defs/inlineRichTextString" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": { "$ref": "#/$defs/inlineRichTextString" },
                        "body": { "$ref": "#/$defs/blockRichTextString" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["form.inquiry-01", "location.map-directions-01"] }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "description": { "$ref": "#/$defs/blockRichTextString" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["trust.testimonials-01", "trust.testimonial-slider-01"] }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "quote": { "$ref": "#/$defs/blockRichTextString" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "content.faq-accordion-01" } }, "required": ["type"] },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "question": { "$ref": "#/$defs/inlineRichTextString" },
                        "answer": { "$ref": "#/$defs/blockRichTextString" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "content.process-timeline-01" } }, "required": ["type"] },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": { "$ref": "#/$defs/inlineRichTextString" },
                        "body": { "$ref": "#/$defs/blockRichTextString" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "content.tabs-01" } }, "required": ["type"] },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "heading": { "$ref": "#/$defs/inlineRichTextString" },
                        "body": { "$ref": "#/$defs/blockRichTextString" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "commerce.comparison-table-01" } }, "required": ["type"] },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": { "$ref": "#/$defs/inlineRichTextString" },
                        "description": { "$ref": "#/$defs/inlineRichTextString" }
                      }
                    }
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "feature": { "$ref": "#/$defs/inlineRichTextString" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "content.article-list-01" } }, "required": ["type"] },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": { "$ref": "#/$defs/inlineRichTextString" },
                        "summary": { "$ref": "#/$defs/blockRichTextString" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "media.video-embed-01" } }, "required": ["type"] },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "caption": { "$ref": "#/$defs/blockRichTextString" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "trust.logo-carousel-01",
                  "g7.board-content-archive-01",
                  "g7.ecommerce-product-showcase-01"
                ]
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["content.event-schedule-01", "content.download-resources-01"] }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "heading": { "$ref": "#/$defs/inlineRichTextString" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": { "$ref": "#/$defs/inlineRichTextString" },
                        "description": { "$ref": "#/$defs/blockRichTextString" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "spacing"],
      "properties": {
        "surface": {
          "enum": ["default", "soft", "contrast"]
        },
        "spacing": {
          "enum": ["compact", "normal", "spacious"]
        },
        "textScale": {
          "enum": ["compact", "balanced", "large"]
        },
        "textAlign": {
          "enum": ["left", "center", "right"]
        },
        "containerWidth": {
          "enum": ["inherit", "narrow", "standard", "wide", "full"]
        },
        "containerAlign": {
          "enum": ["left", "center", "right", "stretch"]
        },
        "minHeight": {
          "enum": ["auto", "compact", "medium", "large", "viewport"]
        },
        "verticalAlign": {
          "enum": ["start", "center", "end"]
        },
        "elements": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[0-9]+)?(?:\\.[A-Za-z][A-Za-z0-9]*)?$"
          },
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9]*(?:\\.[0-9]+)?(?:\\.[A-Za-z][A-Za-z0-9]*)?$": {
              "$ref": "#/$defs/elementAppearance"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "elementAppearance": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "not": {
        "properties": { "size": {}, "fontSizeRem": {} },
        "required": ["size", "fontSizeRem"]
      },
      "properties": {
        "font": { "enum": ["inherit", "system", "modern", "serif", "mono"] },
        "fontSizeRem": { "enum": [0.75, 0.875, 1, 1.125, 1.25, 1.5, 1.75, 2, 2.25, 2.5, 3, 3.5, 4, 4.5, 5, 6] },
        "size": { "enum": ["small", "base", "large", "xlarge"] },
        "weight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "align": { "enum": ["left", "center", "right"] },
        "tone": { "enum": ["default", "muted", "accent", "contrast", "custom1", "custom2", "custom3", "custom4"] }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "intensity", "trigger", "stagger_ms"],
      "properties": {
        "preset": {
          "enum": ["none", "reveal", "stagger", "parallax-soft", "counter", "chart-draw"]
        },
        "intensity": {
          "enum": ["subtle", "normal", "strong"]
        },
        "trigger": {
          "enum": ["once", "repeat"]
        },
        "stagger_ms": {
          "enum": [60, 100, 160]
        }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience"],
      "properties": {
        "audience": { "enum": ["all", "guest", "member"] }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "alt": { "type": "string", "maxLength": 300 }
      }
    },
    "headingProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "level", "anchor"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "heading": { "$ref": "#/$defs/inlineRichTextString", "type": "string", "minLength": 1 },
        "level": { "enum": [2, 3, 4] },
        "anchor": { "type": "string", "maxLength": 80, "pattern": "^(?:$|[a-z][a-z0-9-]{0,79})$" },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "richTextProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "measure"],
      "properties": {
        "content": { "$ref": "#/$defs/blockRichTextString", "type": "string", "minLength": 1 },
        "measure": { "enum": ["narrow", "standard", "wide"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "imageBlockProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "caption", "linkUrl", "aspectRatio"],
      "properties": {
        "src": { "type": "string", "maxLength": 2048 },
        "alt": { "type": "string", "maxLength": 300 },
        "caption": { "type": "string", "maxLength": 500 },
        "linkUrl": { "type": "string", "maxLength": 2048 },
        "aspectRatio": { "enum": ["auto", "16:9", "4:3", "1:1"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      },
      "allOf": [{
        "if": { "properties": { "src": { "type": "string", "minLength": 1 } }, "required": ["src"] },
        "then": { "properties": { "alt": { "type": "string", "minLength": 1 } } }
      }]
    },
    "buttonsProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "alignment"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url", "variant"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
