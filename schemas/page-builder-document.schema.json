        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "format": "email"
        },
        "cta": {
          "$ref": "#/$defs/link"
        },
        "mapLink": {
          "$ref": "#/$defs/link"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        }
      }
    }
  }
