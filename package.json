{
  "name": "@jiwonpapa/g7-page-builder",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "NODE_ENV=production vite build && NODE_ENV=production vite build --config vite.manager.config.ts && NODE_ENV=production vite build --config vite.site-part.config.ts && NODE_ENV=production vite build --config vite.effects.config.ts",
    "build:store": "php scripts/build-official-store.php",
    "generate:block-thumbnails": "node scripts/generate-block-thumbnails.mjs",
    "generate:page-kit-logos": "node scripts/generate-page-kit-logos.mjs",
    "generate:page-kit-screenshots": "node scripts/generate-page-kit-screenshots.mjs",
    "check:store": "bash scripts/check-official-store-build.sh",
    "check:version": "node scripts/check-version-policy.mjs",
    "check:editor-acceptance": "node scripts/check-editor-acceptance-contract.mjs",
    "check:editor-layout-parity": "node scripts/check-editor-layout-parity.mjs",
    "lint:css": "stylelint \"resources/css/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "npm run check:editor-layout-parity && vitest run",
    "test:e2e:infra": "playwright test tests/E2E/infrastructure.spec.ts",
    "test:e2e:performance": "playwright test tests/E2E/editorPerformance.spec.ts --project=desktop",
    "test:e2e:product": "playwright test tests/E2E/pageBuilderLifecycle.spec.ts tests/E2E/sitePartLifecycle.spec.ts tests/E2E/globalSiteShellRoutes.spec.ts tests/E2E/officialStore.spec.ts tests/E2E/publicQuality.spec.ts tests/E2E/blockCatalogQuality.spec.ts tests/E2E/editorPerformance.spec.ts tests/E2E/editorInteractionQuality.spec.ts tests/E2E/editorLayoutParity.spec.ts",
    "check:g7-budget": "node scripts/check-g7-dependency-budget.mjs",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "check:assets": "node scripts/check-assets.mjs",
    "check:frontend-budgets": "node scripts/check-frontend-budgets.mjs",
    "check": "npm run check:version && npm run check:store && npm run check:editor-acceptance && npm run check:editor-layout-parity && npm run typecheck && npm run lint:css && npm run test:coverage && npm run check:g7-budget && npm run check:boundaries && npm run build && npm run check:assets && npm run check:frontend-budgets"
  },
  "dependencies": {
    "@puckeditor/core": "0.23.0",
    "@tiptap/core": "3.30.2",
    "@tiptap/react": "3.30.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "lucide-react": "1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^27.1.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
