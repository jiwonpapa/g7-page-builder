            "type": "object", "additionalProperties": false, "required": ["network", "label", "url"],
            "properties": {
              "network": { "enum": ["instagram", "youtube", "facebook", "linkedin", "x", "kakao", "blog", "website"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "url": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?:/[^\\s]*|https://[^\\s]+)$" }
