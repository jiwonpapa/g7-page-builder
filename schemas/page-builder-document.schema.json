      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "images", "autoplay", "interval", "controls", "aspectRatio"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "heading": { "$ref": "#/$defs/inlineRichTextString", "type": "string", "minLength": 1 },
