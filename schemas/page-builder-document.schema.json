            }
          }
        },
        "alignment": { "enum": ["left", "center", "right"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "imageTextProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "body", "image", "mediaPosition"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "heading": { "$ref": "#/$defs/inlineRichTextString", "type": "string", "minLength": 1 },
        "body": { "$ref": "#/$defs/blockRichTextString" },
