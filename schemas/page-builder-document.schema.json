{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jiwonpapa.dev/g7-page-builder/document-v1.json",
  "title": "G7 Page Builder Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "slug", "mode", "locale", "blocks"],
  "properties": {
    "schema_version": {
      "const": "g7-page-builder/v1"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "const": "canvas"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "shell_mode": {
      "enum": ["template", "builder", "none", "global"],
      "default": "template"
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "og_image_url", "robots"],
      "properties": {
        "title": { "type": "string", "maxLength": 70 },
        "description": { "type": "string", "maxLength": 200 },
        "og_image_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|/[^\\s]*|https://[^\\s]+)$"
        },
        "robots": { "enum": ["index", "noindex"] }
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "design.palette": { "enum": ["indigo", "blue", "emerald", "amber", "rose", "slate"] },
        "design.font": { "enum": ["system", "modern", "serif"] },
        "design.radius": { "enum": ["sharp", "soft", "round"] },
        "design.width": { "enum": ["narrow", "standard", "wide"] },
        "design.scale": { "enum": ["compact", "balanced", "large"] }
      },
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      },
      "default": {}
    },
    "blocks": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "type", "block_version", "props"],
      "properties": {
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]+$"
        },
        "block_version": {
          "type": "integer",
          "minimum": 1
        },
        "props": {
          "type": "object"
        },
        "motion": {
          "$ref": "#/$defs/motion"
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/$defs/block"
            }
          },
          "default": {}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "content.cta-split-01" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "block_version": { "const": 1 },
              "props": { "$ref": "#/$defs/ctaProps" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "content.contact-info-01" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "block_version": { "const": 1 },
              "props": { "$ref": "#/$defs/contactProps" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "content.hero-split-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/heroSplitProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.hero-slider-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/heroSliderProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "trust.logo-cloud-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/logoCloudProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "data.stats-icons-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/statsProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "commerce.pricing-tiers-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/pricingProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "company.team-grid-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/teamProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "media.gallery-grid-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/galleryProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "data.bar-chart-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/barChartProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "g7.board-recent-posts-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/g7RecentPostsProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "g7.ecommerce-product-grid-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/g7ProductGridProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.heading-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/headingProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.rich-text-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/richTextProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "media.image-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/imageBlockProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "action.buttons-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/buttonsProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "media.image-text-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/imageTextProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "content.icon-list-01" } }, "required": ["type"] },
          "then": { "properties": { "block_version": { "const": 1 }, "props": { "$ref": "#/$defs/iconListProps" } } }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "spacing"],
      "properties": {
        "surface": {
          "enum": ["default", "soft", "contrast"]
        },
        "spacing": {
          "enum": ["compact", "normal", "spacious"]
        },
        "textScale": {
          "enum": ["compact", "balanced", "large"]
        },
        "textAlign": {
          "enum": ["left", "center", "right"]
        },
        "elements": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[0-9]+)?(?:\\.[A-Za-z][A-Za-z0-9]*)?$"
          },
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9]*(?:\\.[0-9]+)?(?:\\.[A-Za-z][A-Za-z0-9]*)?$": {
              "$ref": "#/$defs/elementAppearance"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "elementAppearance": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "font": { "enum": ["inherit", "system", "modern", "serif", "mono"] },
        "size": { "enum": ["small", "base", "large", "xlarge"] },
        "weight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "align": { "enum": ["left", "center", "right"] },
        "tone": { "enum": ["default", "muted", "accent", "contrast"] }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "intensity", "trigger", "stagger_ms"],
      "properties": {
        "preset": {
          "enum": ["none", "reveal", "stagger", "parallax-soft", "counter", "chart-draw"]
        },
        "intensity": {
          "enum": ["subtle", "normal", "strong"]
        },
        "trigger": {
          "enum": ["once", "repeat"]
        },
        "stagger_ms": {
          "enum": [60, 100, 160]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "alt": { "type": "string", "maxLength": 300 }
      }
    },
    "headingProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "level", "anchor"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "level": { "enum": [2, 3, 4] },
        "anchor": { "type": "string", "maxLength": 80, "pattern": "^(?:$|[a-z][a-z0-9-]{0,79})$" },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "richTextProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "measure"],
      "properties": {
        "content": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "measure": { "enum": ["narrow", "standard", "wide"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "imageBlockProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "caption", "linkUrl", "aspectRatio"],
      "properties": {
        "src": { "type": "string", "maxLength": 2048 },
        "alt": { "type": "string", "maxLength": 300 },
        "caption": { "type": "string", "maxLength": 500 },
        "linkUrl": { "type": "string", "maxLength": 2048 },
        "aspectRatio": { "enum": ["auto", "16:9", "4:3", "1:1"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      },
      "allOf": [{
        "if": { "properties": { "src": { "type": "string", "minLength": 1 } }, "required": ["src"] },
        "then": { "properties": { "alt": { "type": "string", "minLength": 1 } } }
      }]
    },
    "buttonsProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "alignment"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url", "variant"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "variant": { "enum": ["primary", "secondary", "text"] }
            }
          }
        },
        "alignment": { "enum": ["left", "center", "right"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "imageTextProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "body", "image", "mediaPosition"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string", "maxLength": 10000 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt"],
          "properties": {
            "src": { "type": "string", "maxLength": 2048 },
            "alt": { "type": "string", "maxLength": 300 }
          },
          "allOf": [{
            "if": { "properties": { "src": { "type": "string", "minLength": 1 } }, "required": ["src"] },
            "then": { "properties": { "alt": { "type": "string", "minLength": 1 } } }
          }]
        },
        "mediaPosition": { "enum": ["left", "right"] },
        "primaryLink": { "$ref": "#/$defs/link" },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "iconListProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "items", "layout"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["icon", "title", "body"],
            "properties": {
              "icon": { "enum": ["bolt", "check", "code", "globe", "heart", "layers", "mobile", "palette", "shield", "sparkles", "star"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "body": { "type": "string", "maxLength": 2000 }
            }
          }
        },
        "layout": { "enum": ["single", "two-column"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "heroSplitProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "body", "mediaPosition"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string", "maxLength": 2000 },
        "primaryCta": { "$ref": "#/$defs/link" },
        "image": { "$ref": "#/$defs/image" },
        "mediaPosition": { "enum": ["left", "right"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "heroSliderProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slides"],
      "properties": {
        "slides": {
          "type": "array", "minItems": 2, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["eyebrow", "title", "body", "buttonLabel", "buttonUrl", "imageSrc", "imageAlt"],
            "properties": {
              "eyebrow": { "type": "string", "maxLength": 120 },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "body": { "type": "string", "maxLength": 2000 },
              "buttonLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
              "buttonUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "imageSrc": { "type": "string", "maxLength": 2048 },
              "imageAlt": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "autoplay": { "type": "boolean", "default": true },
        "interval": { "enum": [3000, 5000, 7000], "default": 5000 },
        "loop": { "type": "boolean", "default": true },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "logoCloudProps": {
      "type": "object", "additionalProperties": false, "required": ["heading", "logos"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "logos": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["name", "imageSrc", "imageAlt", "url"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "imageSrc": { "type": "string", "maxLength": 2048 }, "imageAlt": { "type": "string", "maxLength": 300 }, "url": { "type": "string", "maxLength": 2048 } } } },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "statsProps": {
      "type": "object", "additionalProperties": false, "required": ["eyebrow", "heading", "items"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 }, "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "items": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["icon", "value", "label", "detail"], "properties": { "icon": { "enum": ["trend", "users", "target", "chart"] }, "value": { "type": "string", "minLength": 1, "maxLength": 80 }, "label": { "type": "string", "minLength": 1, "maxLength": 120 }, "detail": { "type": "string", "maxLength": 500 } } } },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "pricingProps": {
      "type": "object", "additionalProperties": false, "required": ["eyebrow", "heading", "plans"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 }, "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "plans": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["name", "price", "period", "description", "features", "buttonLabel", "buttonUrl", "featured"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "price": { "type": "string", "minLength": 1, "maxLength": 80 }, "period": { "type": "string", "maxLength": 40 }, "description": { "type": "string", "maxLength": 500 }, "features": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "buttonLabel": { "type": "string", "minLength": 1, "maxLength": 120 }, "buttonUrl": { "type": "string", "minLength": 1, "maxLength": 2048 }, "featured": { "type": "boolean" } } } },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "teamProps": {
      "type": "object", "additionalProperties": false, "required": ["eyebrow", "heading", "members"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 }, "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "members": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["name", "role", "bio", "imageSrc", "imageAlt", "profileUrl"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "role": { "type": "string", "minLength": 1, "maxLength": 160 }, "bio": { "type": "string", "maxLength": 1000 }, "imageSrc": { "type": "string", "maxLength": 2048 }, "imageAlt": { "type": "string", "maxLength": 300 }, "profileUrl": { "type": "string", "maxLength": 2048 } } } },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "galleryProps": {
      "type": "object", "additionalProperties": false, "required": ["eyebrow", "heading", "images", "columns"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 }, "heading": { "type": "string", "minLength": 1, "maxLength": 200 }, "columns": { "enum": [2, 3, 4] },
        "images": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["src", "alt", "caption"], "properties": { "src": { "type": "string", "maxLength": 2048 }, "alt": { "type": "string", "minLength": 1, "maxLength": 300 }, "caption": { "type": "string", "maxLength": 300 } } } },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "barChartProps": {
      "type": "object", "additionalProperties": false, "required": ["eyebrow", "heading", "description", "unit", "items"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 }, "heading": { "type": "string", "minLength": 1, "maxLength": 200 }, "description": { "type": "string", "maxLength": 1000 }, "unit": { "type": "string", "maxLength": 20 },
        "items": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["label", "value", "tone"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 120 }, "value": { "type": "number", "minimum": 0, "maximum": 100 }, "tone": { "enum": ["blue", "indigo", "emerald", "amber"] } } } },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "g7RecentPostsProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "source", "period", "limit", "audience", "emptyMessage"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "enum": ["recent", "popular"] },
        "period": { "enum": ["today", "week", "month", "year"] },
        "limit": { "enum": [3, 4, 6, 8, 12] },
        "audience": { "enum": ["all", "guest", "member"] },
        "emptyMessage": { "type": "string", "minLength": 1, "maxLength": 300 },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "g7ProductGridProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "source", "limit", "columns", "audience", "detailBasePath", "emptyMessage"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 120 },
        "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "enum": ["latest", "new", "popular"] },
        "limit": { "enum": [2, 3, 4, 6, 8, 12] },
        "columns": { "enum": [2, 3, 4] },
        "audience": { "enum": ["all", "guest", "member"] },
        "detailBasePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^/[a-zA-Z0-9/_-]*$"
        },
        "emptyMessage": { "type": "string", "minLength": 1, "maxLength": 300 },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "ctaProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "body", "theme"],
      "properties": {
        "eyebrow": {
          "type": "string",
          "maxLength": 120
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "maxLength": 2000
        },
        "primaryLink": {
          "$ref": "#/$defs/link"
        },
        "secondaryLink": {
          "$ref": "#/$defs/link"
        },
        "theme": {
          "enum": ["light", "dark"]
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        }
      }
    },
    "contactProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "address", "phone", "email"],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "phone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^\\+?[0-9][0-9 .()\\-]{2,39}$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "format": "email"
        },
        "cta": {
          "$ref": "#/$defs/link"
        },
        "mapLink": {
          "$ref": "#/$defs/link"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        }
      }
    }
  }
}
