{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g7devops.com/schemas/g7-page-builder/site-part-document-v1.json",
  "title": "G7 Page Builder SitePartDocument v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_part_id", "kind", "locale", "tokens", "blocks"],
  "properties": {
    "schema_version": { "const": "g7-page-builder/site-part/v1" },
    "site_part_id": { "type": "string", "format": "uuid" },
    "kind": { "enum": ["header", "footer"] },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "safeUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:/(?!/)[^\\s]*|#[^\\s]*|https?://[^\\s]+|mailto:[^\\s]+|tel:[^\\s]+)$"
    },
    "imageUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:$|/(?!/)[^\\s]*|https?://[^\\s]+)$"
    },
    "leafLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "$ref": "#/$defs/safeUrl" }
      }
    },
    "navigationLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "$ref": "#/$defs/safeUrl" },
        "children": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/leafLink" }
        }
      }
    },
    "headerResponsiveOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "alignment": { "enum": ["start", "center", "spread"] },
        "show_cta": { "type": "boolean" },
        "mobile_menu_style": { "enum": ["dropdown", "drawer-left", "drawer-right", "sheet-bottom"] }
      }
    },
    "headerResponsive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tablet": { "$ref": "#/$defs/headerResponsiveOverride" },
        "mobile": { "$ref": "#/$defs/headerResponsiveOverride" }
      }
    },
    "footerResponsiveOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "alignment": { "enum": ["start", "center"] },
        "show_navigation": { "type": "boolean" },
        "columns": { "enum": [1, 2, 4] }
      }
    },
    "footerResponsive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tablet": { "$ref": "#/$defs/footerResponsiveOverride" },
        "mobile": { "$ref": "#/$defs/footerResponsiveOverride" }
      }
    },
    "baseBlock": {
      "type": "object",
      "required": ["instance_id", "type", "block_version", "props", "slots"],
      "properties": {
        "instance_id": { "type": "string", "format": "uuid" },
        "type": { "type": "string" },
        "block_version": { "const": 1 },
        "props": { "type": "object" },
        "slots": { "type": "object", "maxProperties": 0 }
      }
    },
    "headerNavigation": {
      "allOf": [
        { "$ref": "#/$defs/baseBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instance_id": true,
            "type": { "const": "site.header.navigation-01" },
            "block_version": true,
            "slots": true,
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["brand_name", "home_url", "navigation"],
              "properties": {
                "brand_name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "logo_url": { "$ref": "#/$defs/imageUrl" },
                "home_url": { "$ref": "#/$defs/safeUrl" },
                "variant": { "enum": ["solid", "transparent"] },
                "sticky": { "type": "boolean" },
                "navigation": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/navigationLink" } },
                "cta": { "anyOf": [{ "$ref": "#/$defs/leafLink" }, { "type": "null" }] },
                "mobile_menu": { "type": "boolean" },
                "mobile_menu_style": { "enum": ["dropdown", "drawer-left", "drawer-right", "sheet-bottom"] },
                "responsive": { "$ref": "#/$defs/headerResponsive" }
              }
            }
          }
        }
      ]
    },
    "announcement": {
      "allOf": [
        { "$ref": "#/$defs/baseBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instance_id": true,
            "type": { "const": "site.header.announcement-01" },
            "block_version": true,
            "slots": true,
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "tone"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 240 },
                "link_label": { "type": "string", "maxLength": 80 },
                "link_url": { "anyOf": [{ "$ref": "#/$defs/safeUrl" }, { "const": "" }] },
                "tone": { "enum": ["brand", "dark", "light"] }
              }
            }
          }
        }
      ]
    },
    "footerSimple": {
      "allOf": [
        { "$ref": "#/$defs/baseBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instance_id": true,
            "type": { "const": "site.footer.simple-01" },
            "block_version": true,
            "slots": true,
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["brand_name", "home_url", "navigation"],
              "properties": {
                "brand_name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "home_url": { "$ref": "#/$defs/safeUrl" },
                "navigation": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/leafLink" } },
                "footer_text": { "type": "string", "maxLength": 500 },
                "responsive": { "$ref": "#/$defs/footerResponsive" }
              }
            }
          }
        }
      ]
    },
    "footerColumns": {
      "allOf": [
        { "$ref": "#/$defs/baseBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instance_id": true,
            "type": { "const": "site.footer.columns-01" },
            "block_version": true,
            "slots": true,
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["brand_name", "home_url", "columns"],
              "properties": {
                "brand_name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "home_url": { "$ref": "#/$defs/safeUrl" },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["heading", "links"],
                    "properties": {
                      "heading": { "type": "string", "minLength": 1, "maxLength": 80 },
                      "links": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/leafLink" } }
                    }
                  }
                },
                "legal_text": { "type": "string", "maxLength": 500 },
                "responsive": { "$ref": "#/$defs/footerResponsive" }
              }
            }
          }
        }
      ]
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/headerNavigation" },
        { "$ref": "#/$defs/announcement" },
        { "$ref": "#/$defs/footerSimple" },
        { "$ref": "#/$defs/footerColumns" }
      ]
    }
  }
}
