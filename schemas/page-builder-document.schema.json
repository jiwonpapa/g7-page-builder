              "linkUrl": { "type": "string", "maxLength": 2048, "pattern": "^(?:$|/[^\\s]*|https://[^\\s]+|mailto:[^\\s]+|tel:[^\\s]+)$" }
            }
          }
        },
        "columns": { "enum": [2, 3] },
        "variant": { "enum": ["plain", "outlined"] },
        "layout": { "enum": ["grid", "bento", "rail", "editorial", "numbered"] },
