{
  "policy_version": "g7pb-design-policy/v3",
  "schema_version": "g7-page-builder/v3",
  "default_tokens": {
    "text": { "kind": "hex", "value": "#112233" },
    "muted": { "kind": "hex", "value": "#667788" },
    "primary": { "kind": "hex", "value": "#2255ff" },
    "surface": { "kind": "hex", "value": "#ffffff" },
    "border": { "kind": "hex", "value": "#ddeeff" },
    "accent": { "kind": "hex", "value": "#ff8800" }
  },
  "limits": {
    "nodes": 500,
    "depth": 16,
    "utf8_bytes": 1048576,
    "json_depth": 128,
    "transaction_commands": 32
  },
  "breakpoints": {
    "tablet": 640,
    "desktop": 1024
  },
  "units": {
    "px": "css-pixel",
    "rem": "root-font-size",
    "vw": "viewport-width-percent",
    "vh": "viewport-height-percent",
    "%": "property-containing-block-percent"
  },
  "defaults": {
    "display": "block",
    "position": "flow",
    "hidden": false,
    "opacity": 1
  },
  "performance": {
    "nodes": [
      100,
      500
    ],
    "validation_ms": 1000
  },
  "node_props": {
    "layout.section": [
      "tag"
    ],
    "layout.container": [
      "tag"
    ],
    "content.heading": [
      "level",
      "runs"
    ],
    "content.text": [
      "paragraphs"
    ],
    "media.icon": ["icon", "label", "decorative"],
    "media.embed": ["title", "source"],
    "form.control": ["kind", "label", "placeholder"],
    "form.label": ["label"],
    "media.image": [
      "asset_id",
      "alt"
    ],
    "action.link": [
      "label",
      "link"
    ],
    "action.button": [
      "label"
    ]
  },
  "containers": [
    "layout.section",
    "layout.container"
  ],
  "behaviors": {
    "layout_types": ["layout.section", "layout.container"],
    "layout_tags": ["section", "article", "aside", "div", "nav", "header", "footer", "li", "dd", "figure", "td", "th"],
    "trigger_types": ["action.button"]
  },
  "systems": { "host_types": ["layout.container"], "host_tags": ["div", "nav"] },
  "data": {
    "host_types": ["layout.container"], "host_tags": ["div"],
    "properties": { "text": ["content.heading", "content.text", "action.link"], "image": ["media.image"], "link": ["action.link"] },
    "fields": { "text": ["title", "description", "meta", "price"], "image": ["image"], "link": ["link"] },
    "feeds": { "posts": ["recent", "popular", "board"], "post-archive": ["recent", "popular"], "post-detail": ["recent"], "products": ["latest", "new", "popular"], "product-showcase": ["latest", "new", "popular"], "product-detail": ["latest"] }
  },
  "bindings": {
    "host_types": ["layout.section", "layout.container"],
    "host_tags": ["section", "article", "aside", "div", "nav", "header", "footer", "li", "dd", "figure", "td", "th"],
    "fields": {
      "name": {"kind": "text", "required": true, "max_length": 120, "autocomplete": "name"},
      "email": {"kind": "email", "required": true, "max_length": 320, "autocomplete": "email"},
      "phone": {"kind": "tel", "required": false, "max_length": 40, "autocomplete": "tel"},
      "subject": {"kind": "text", "required": false, "max_length": 200, "autocomplete": "off"},
      "message": {"kind": "textarea", "required": true, "max_length": 5000, "autocomplete": "off"},
      "privacy": {"kind": "checkbox", "required": true}
    }
  },
  "semantics": {
    "children": {
      "ul": ["li"], "ol": ["li"], "dl": ["dt", "dd"],
      "table": ["caption", "thead", "tbody", "tfoot"],
      "thead": ["tr"], "tbody": ["tr"], "tfoot": ["tr"], "tr": ["th", "td"]
    },
    "parents": {
      "li": ["ul", "ol"], "dt": ["dl"], "dd": ["dl"], "figcaption": ["figure"],
      "caption": ["table"], "thead": ["table"], "tbody": ["table"], "tfoot": ["table"],
      "tr": ["thead", "tbody", "tfoot"], "th": ["tr"], "td": ["tr"]
    },
    "display": {
      "li": "list-item", "table": "table", "caption": "table-caption",
      "thead": "table-header-group", "tbody": "table-row-group", "tfoot": "table-footer-group",
      "tr": "table-row", "th": "table-cell", "td": "table-cell"
    },
    "sequence": { "table": { "order": ["caption", "thead", "tbody", "tfoot"], "singletons": ["caption", "thead", "tfoot"] } },
    "edge_children": { "figure": ["figcaption"] }
  },
  "migration": {
    "source_schemas": [
      "g7-page-builder/v1",
      "g7-page-builder/v2"
    ],
    "source_max_bytes": 1048576,
    "automatic": false,
    "requires": [
      "explicit_choice",
      "source_revision",
      "source_snapshot",
      "supported_mapping",
      "candidate_validation"
    ],
    "publishes": false
  }
}
