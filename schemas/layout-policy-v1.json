  "leaf_types": [
    "content.heading-01",
    "content.rich-text-01",
    "media.image-01",
    "action.buttons-01",
    "content.divider-01"
  ],
  "layouts": {
    "section": "layout.section-01",
    "columns": "layout.columns-01",
    "stack": "layout.stack-01"
  },
  "child_groups": {
    "root": ["compatibility", "section"],
    "section": ["columns", "stack", "leaf"],
    "columns": ["stack", "leaf"],
    "stack": ["leaf"]
  },
  "ratios": {
    "1": [
      "1"
    ],
    "2": [
      "1:1",
      "1:2",
      "2:1"
    ],
    "3": [
      "1:1:1"
    ]
  },
  "gap_px": {
    "none": 0,
    "compact": 8,
    "normal": 16,
    "spacious": 24
  }
}
