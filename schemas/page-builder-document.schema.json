          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["src", "alt", "caption"],
            "properties": {
              "src": { "type": "string", "maxLength": 2048, "pattern": "^(?:$|/[^\\s]*|https://[^\\s]+)$" },
              "alt": { "type": "string", "minLength": 1, "maxLength": 300 },
              "caption": { "type": "string", "maxLength": 300 }
            }
          }
        },
