              "body": { "$ref": "#/$defs/blockRichTextString" }
            }
          }
        },
        "layout": { "enum": ["single", "two-column"] },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "heroSplitProps": {
      "type": "object",
      "additionalProperties": false,
