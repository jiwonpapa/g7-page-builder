{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jiwonpapa.dev/g7-page-builder/document-v1.json",
  "title": "G7 Page Builder Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "slug", "mode", "locale", "blocks"],
  "properties": {
    "schema_version": {
      "const": "g7-page-builder/v1"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "const": "canvas"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      },
      "default": {}
    },
    "blocks": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "type", "block_version", "props"],
      "properties": {
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]+$"
        },
        "block_version": {
          "type": "integer",
          "minimum": 1
        },
        "props": {
          "type": "object"
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/$defs/block"
            }
          },
          "default": {}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "content.cta-split-01" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "block_version": { "const": 1 },
              "props": { "$ref": "#/$defs/ctaProps" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "content.contact-info-01" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "block_version": { "const": 1 },
              "props": { "$ref": "#/$defs/contactProps" }
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "spacing"],
      "properties": {
        "surface": {
          "enum": ["default", "soft", "contrast"]
        },
        "spacing": {
          "enum": ["compact", "normal", "spacious"]
        }
      }
    },
    "ctaProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "body", "theme"],
      "properties": {
        "eyebrow": {
          "type": "string",
          "maxLength": 120
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "maxLength": 2000
        },
        "primaryLink": {
          "$ref": "#/$defs/link"
        },
        "secondaryLink": {
          "$ref": "#/$defs/link"
        },
        "theme": {
          "enum": ["light", "dark"]
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        }
      }
    },
    "contactProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "address", "phone", "email"],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "phone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^\\+?[0-9][0-9 .()\\-]{2,39}$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "format": "email"
        },
        "cta": {
          "$ref": "#/$defs/link"
        },
        "mapLink": {
          "$ref": "#/$defs/link"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        }
      }
    }
  }
}
