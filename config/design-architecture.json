{
  "version": 1,
  "constitution": "docs/development-constitution.md",
  "normativeFiles": [
    "AGENTS.md",
    "docs/architecture.md",
    "docs/development-constitution.md",
    "docs/productization/editing-policy.md",
    "docs/productization/requirements.md",
    "docs/quality-harness.md",
    "docs/worktree-coordination.md"
  ],
  "sourceRoots": [
    "resources/js",
    "resources/css",
    "src"
  ],
  "rules": [
    "TS-BOUNDARY",
    "TS-UNSAFE",
    "G7-INTERNAL",
    "NATIVE-BOUNDARY",
    "PHP-BOUNDARY",
    "SOURCE-SIZE",
    "CSS-COLOR",
    "CSS-IMPORTANT",
    "CSS-SPECIFICITY"
  ],
  "sourceSize": {
    "ts": 800,
    "tsx": 800,
    "js": 800,
    "php": 800,
    "css": 1000
  },
  "maxTypeScriptNodes": 10000,
  "typescriptLayers": [
    {
      "from": "resources/js/documents/",
      "localPrefixes": [
        "resources/js/documents/",
        "schemas/"
      ],
      "localFiles": [],
      "packages": []
    },
    {
      "from": "resources/js/api/",
      "localPrefixes": [
        "resources/js/api/",
        "resources/js/documents/"
      ],
      "localFiles": [
        "resources/js/blocks/types.ts",
        "resources/js/store/types.ts"
      ],
      "packages": []
    },
    {
      "from": "resources/js/public/",
      "localPrefixes": [
        "resources/js/public/",
        "resources/js/documents/"
      ],
      "localFiles": [
        "resources/css/page-builder-public.css",
        "resources/css/page-builder-site-part-responsive.css",
        "resources/css/page-builder-site-shell.css",
        "resources/css/page-builder-theme.css",
        "resources/js/adapters/gnuboard7/bootstrap.ts"
      ],
      "packages": [
        "embla-carousel",
        "embla-carousel-autoplay"
      ]
    },
    {
      "from": "resources/js/native-editor/domain/",
      "localPrefixes": [
        "resources/js/native-editor/domain/"
      ],
      "localFiles": [],
      "packages": []
    },
    {
      "from": "resources/js/native-editor/ports/",
      "localPrefixes": [
        "resources/js/native-editor/domain/",
        "resources/js/native-editor/ports/"
      ],
      "localFiles": [],
      "packages": []
    },
    {
      "from": "resources/js/native-editor/application/",
      "localPrefixes": [
        "resources/js/native-editor/domain/",
        "resources/js/native-editor/ports/",
        "resources/js/native-editor/application/"
      ],
      "localFiles": [],
      "packages": []
    },
    {
      "from": "resources/js/native-editor/ui/",
      "localPrefixes": [
        "resources/js/native-editor/domain/",
        "resources/js/native-editor/ports/",
        "resources/js/native-editor/application/",
        "resources/js/native-editor/ui/"
      ],
      "localFiles": [],
      "packages": [
        "react",
        "react-dom"
      ]
    },
    {
      "from": "resources/js/native-editor/",
      "localPrefixes": [
        "resources/js/native-editor/",
        "resources/js/adapters/gnuboard7/"
      ],
      "localFiles": [],
      "packages": [
        "react",
        "react-dom"
      ]
    },
    {
      "from": "resources/js/adapters/gnuboard7/",
      "localPrefixes": [
        "resources/js/native-editor/",
        "resources/js/adapters/gnuboard7/"
      ],
      "localFiles": [],
      "packages": [
        "react",
        "react-dom"
      ]
    },
    {
      "from": "resources/js/native-components/",
      "localPrefixes": [
        "resources/js/native-components/"
      ],
      "localFiles": [],
      "packages": [
        "react"
      ]
    }
  ],
  "phpNamespace": "Modules\\Jiwonpapa\\PageBuilder\\",
  "phpLayers": {
    "Domain": [
      "Domain"
    ],
    "Contracts": [
      "Contracts",
      "Domain"
    ],
    "Application": [
      "Application",
      "Contracts",
      "Domain"
    ]
  },
  "phpForbiddenNamespaces": [
    "App",
    "Illuminate",
    "Modules\\Sirsoft"
  ],
  "cssTokenSources": [
    "resources/css/page-builder-core.css",
    "resources/css/page-builder-theme.css"
  ],
  "debtFile": "config/design-architecture-debt.json",
  "nativeEditor": {
    "root": "resources/js/native-editor/",
    "adapter": "resources/js/adapters/gnuboard7/",
    "methods": [
      "registerWidget",
      "registerNodeEditor",
      "registerCanvasOverlay",
      "onReady",
      "registerPanel"
    ]
  }
}
