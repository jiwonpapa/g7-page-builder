        "images": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["src", "alt", "caption"], "properties": { "src": { "type": "string", "maxLength": 2048 }, "alt": { "type": "string", "minLength": 1, "maxLength": 300 }, "caption": { "type": "string", "maxLength": 300 } } } },
